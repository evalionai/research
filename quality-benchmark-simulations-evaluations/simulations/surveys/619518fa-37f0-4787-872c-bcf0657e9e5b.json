  "questions": [
    {
      "id": "study-pairwise-comparison-001",
      "prompt": "Which audio is more aligned with the following statement?\nThe customer talked about all the issues in the scenario.",
      "type": "comparison",
      "options": [
        "Left recording",
        "Right recording",
        "No difference between recordings"
      ]
    },
    {
      "id": "study-pairwise-comparison-002",
      "prompt": "Which audio is more aligned with the following statement?\nThe customer explained their problems clearly and correctly.",
      "type": "comparison",
      "options": [
        "Left recording",
        "Right recording",
        "No difference between recordings"
      ]
    },
    {
      "id": "study-pairwise-comparison-003",
      "prompt": "Which audio is more aligned with the following statement?\nThe customer made sure that all the problems they mentioned were addressed during the call (for example by asking follow-up questions, coming back to an unresolved step...)",
