  "questions": [
    {
      "id": "905daccc-0d7a-4ea0-8061-2de50741468d",
      "prompt": "How satisfied would you be with the customer support service, if you were the customer (user) on that call?\nGive a score between 1 and 5, where 1 is \"very unsatisfied\" and 5 is \"very satisfied\".",
      "type": "numeric",
      "range": {
        "min": 1.0,
        "max": 5.0
      }
    },
    {
      "id": "4d7e068e-e907-4da1-8f93-6747b2ec8f0a",
      "prompt": "Did the assistant appropriately end the call?\nExamples of not ending a call appropriately could be, ending the call mid-conversation or without a goodbye.",
      "type": "binary",
      "options": [
        "yes",
        "no"
      ]
    },
    {
      "id": "4a57f796-a7e9-4203-be05-e05e03eac50e",
      "prompt": "Did the assistant manage to avoid repeating the same response or entering a conversational loop?",
      "type": "binary",
      "options": [
        "yes",
        "no"
      ]
    },
    {
      "id": "85c441cd-9287-49a7-8348-6d45576a7018",
      "prompt": "Did the assistant help move the conversation toward solving the problem?\nEach assistant's response should bring the conversation closer to resolving the reason for the call.",
      "type": "binary",
      "options": [
        "yes",
        "no"
      ]
    },
    {
      "id": "1776edb6-09e2-472a-97d0-dfba0d7a538e",
      "prompt": "Did the assistant stay consistent throughout the conversation?\nThat is, did the assistant keep the same tone of voice, gave answers that didn\u2019t contradict each other, and handled similar questions in the same way?\nFor example, not saying yes to a refund early on and then no later without good reason.",
      "type": "binary",
      "options": [
        "yes",
        "no"
      ]
    },
    {
      "id": "5e188519-11c0-47d0-b8f4-6826fbb1fe15",
      "prompt": "Did the conversation reach the following expected outcome?\n\nNote that the expected outcome is a bullet-point list of statements.\nAnswer YES, if all of the statements are true for the conversation.\nAnswer NO, if any of the statements is false.\n\nExpected outcome:\n- The user asks several questions\n- The assistant guides user to use \"Upload Additional Documents\" option for uploading trailing documents\n- The assistant identifies that file size limits are not covered in the provided FAQs\n- The assistant identifies that loan interest rate location in UI is not covered in the provided FAQs\n- The assistant identifies that upload notification details are not covered in the provided FAQs\n- The assistant does not attempt to answer or improvise responses for questions not documented in the FAQs\n- The assistant transfers the call to human support",
      "type": "binary",
      "options": [
        "yes",
        "no"
      ]
    }
  ]
}